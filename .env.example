# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (captcha da tela de login)
# Crie em: Cloudflare Dashboard > Turnstile > Add widget (adicione o domínio do sistema e "localhost").
# A chave do site é pública; a chave secreta fica SÓ no servidor (Vercel > Settings > Environment Variables).
# Para testar localmente sem conta, a Cloudflare oferece chaves de teste que sempre aprovam:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
